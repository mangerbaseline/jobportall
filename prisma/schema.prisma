generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String              @id @default(cuid())
  name                 String
  email                String              @unique
  password             String?
  role                 Role                @default(USER)
  createdAt            DateTime            @default(now())
  deleted              Boolean             @default(false)
  verified             Boolean             @default(false)
  employed             Boolean             @default(false)
  companyName          String              @default("nan")
  employerApplications Application[]       @relation("EmployerApplications")
  applications         Application[]
  jobs                 Job[]               @relation("EmployerJobs")
  personal             PersonalDetail?
  professional         ProfessionalDetail?
  savedJobs            SavedJob[]
}

model Job {
  id           String        @id @default(cuid())
  title        String
  description  String
  location     String
  salary       Int?
  createdAt    DateTime      @default(now())
  employerId   String
  vacancy      Int           @default(0)
  available    Boolean       @default(true)
  applications Application[]
  employer     User          @relation("EmployerJobs", fields: [employerId], references: [id], onDelete: Cascade)
  savedJobs    SavedJob[]
}

model Application {
  id             String            @id @default(cuid())
  resumeUrl      String
  status         ApplicationStatus @default(PENDING)
  createdAt      DateTime          @default(now())
  userId         String
  jobId          String
  employerId     String
  availableDate  DateTime?
  expectedSalary Int?
  experience     Int?
  jobTitle       String?
  noticePeriod   Int?
  employer       User              @relation("EmployerApplications", fields: [employerId], references: [id])
  job            Job               @relation(fields: [jobId], references: [id])
  user           User              @relation(fields: [userId], references: [id])

  @@unique([userId, jobId])
}

model PersonalDetail {
  id        String    @id @default(cuid())
  phone     String?
  address   String?
  city      String?
  state     String?
  country   String?
  zipCode   String?
  dob       DateTime?
  gender    String?
  bio       String?
  avatar    String?
  website   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id])
}

model ProfessionalDetail {
  id             String   @id @default(cuid())
  title          String?
  experience     Int?
  skills         String?
  education      String?
  certifications String?
  currentSalary  Int?
  expectedSalary Int?
  noticePeriod   Int?
  resume         String?
  linkedin       String?
  github         String?
  portfolio      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  userId         String   @unique
  companyName    String?
  user           User     @relation(fields: [userId], references: [id])
}

model SavedJob {
  id     String @id @default(cuid())
  userId String
  jobId  String
  job    Job    @relation(fields: [jobId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, jobId])
}

model AboutUs {
  id         String   @id @default(cuid())
  heading    String
  subHeading String?
  content    String
  mission    String?
  vision     String?
  imageUrl   String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ContactUs {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  adminNote String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PrivacyPolicy {
  id          String   @id @default(cuid())
  version     String
  title       String
  content     String
  effectiveAt DateTime
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum Role {
  USER
  ADMIN
  EMPLOYER
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}
